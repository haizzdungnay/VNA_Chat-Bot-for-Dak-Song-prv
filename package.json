{
  "name": "vna-dak-song-travel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "miniapp",
    "worker"
  ],
  "scripts": {
    "dev:miniapp": "npm --workspace miniapp run dev",
    "dev:worker": "npm --workspace worker run dev",
    "build:miniapp": "npm --workspace miniapp run build",
    "build:worker": "npm --workspace worker run build",
    "build": "npm run build:miniapp && npm run build:worker",
    "typecheck:miniapp": "npm --workspace miniapp run typecheck",
    "typecheck:worker": "npm --workspace worker run typecheck",
    "typecheck": "npm run typecheck:miniapp && npm run typecheck:worker",
    "test": "npm --workspace worker run test"
  }
}
