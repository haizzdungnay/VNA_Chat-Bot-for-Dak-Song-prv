# Cloudflare Worker Local Development Variables (.dev.vars)
# Copy file nay thanh .dev.vars khi chay local

# Chon AI provider: 'workers-ai' hoac 'openai-compatible'
AI_PROVIDER=workers-ai
AI_MODEL=@cf/meta/llama-3.1-8b-instruct

# Neu su dung openai-compatible:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=your_api_key_here
# AI_MODEL=gpt-4o-mini

# CORS config (mac dinh * trong dev)
CORS_ALLOW_ORIGIN=*
