# Cloudflare Worker Local Development Variables (.dev.vars)
# Copy file nay thanh .dev.vars khi chay local

# Google Gemini (qua endpoint OpenAI-compatible)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash
AI_REASONING_EFFORT=low
AI_JSON_MODE=true
AI_API_KEY=your_gemini_api_key_here

# Hoac Cloudflare Workers AI mac dinh:
# AI_PROVIDER=workers-ai
# AI_MODEL=@cf/meta/llama-3.1-8b-instruct-fast

# CORS config (mac dinh * trong dev)
CORS_ALLOW_ORIGIN=*
