{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vna-dak-song-demo",
  "main": "src/index.ts",
  "compatibility_date": "2024-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "placement": {
    "mode": "smart"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dak-song-db-staging",
      "database_id": "9c1d6303-7245-4baf-a3d4-114b63f8002a",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "AI_PROVIDER": "openai-compatible",
    "AI_BASE_URL": "https://rrdf59c.abc-tunnel.us/v1",
    "AI_MODEL": "ag/gemini-3.8-flash-low",
    "AI_REASONING_EFFORT": "low",
    "AI_JSON_MODE": "false",
    "ALLOWED_AI_HOSTS": "*",
    "ADMIN_DEV_MOCK_AUTH": "true",
    "ADMIN_AI_CONFIG_ENABLED": "true",
    "CORS_ALLOW_ORIGIN": "*"
  }
}

